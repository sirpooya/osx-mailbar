# macOS
.DS_Store

# Xcode build output and DerivedData. build/ and Build/ are the same folder on a
# case-insensitive disk; both spellings appear in the packaging scripts
# (osx-autoconnect/Scripts/make-app.sh writes build/, osx-download-manager/scripts/package_app.sh writes Build/).
build/
Build/
DerivedData/
# -derivedDataPath folders: osx-font-manager uses .dd/, osx-feather-app uses dd/
.dd/
dd/

# Per-user Xcode state. Never commit (osx-launchpad and osx-prairie still track it: legacy).
xcuserdata/
*.xcuserstate

# SwiftPM
.build/
.swiftpm/

# XcodeGen output: project.yml is the source of truth (flipoff, feather, inspora, whisper,
# font-manager). Delete this line only if the .xcodeproj is committed on purpose
# (dynamic-island, launchpad, prairie, claude-usage do).
*.xcodeproj

# Release artifacts: uploaded to GitHub Releases, never committed (osx-launchpad/.gitignore)
*.dmg
*.zip
*.dSYM
*.dSYM.zip

# Sparkle EdDSA private key: lives in the login keychain and the SPARKLE_PRIVATE_KEY repo
# secret, never in the tree (osx-flipoff/.gitignore, osx-launchpad/.gitignore)
*.pem
sparkle_key*
sparkle_private_key*
exported_key*

# Local-only Claude settings (osx-prairie/.gitignore)
.claude/settings.local.json

# Vendored native builds regenerated by a script. Add per project:
#   Vendor/        osx-download-manager (libtorrent, scripts/build_libtorrent.sh)
#   third_party/   osx-whisper-app (whisper.cpp, scripts/build-whisper.sh)

# mac-qc scratch (screenshots, AX dumps). Disposable, cleaned after every pass.
_qc/
